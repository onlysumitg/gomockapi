{{define "title"}}
Endpoint detail
{{end}}

{{define "content"}}
<br />
<div class="px-5">

    <div class="row">

  

        <div class="col-10">
            <div class="row">
                <div class="col" style="padding-bottom: 10px;">
                    <p class="h5">EndPoint Details</p>
                </div>

            </div>



            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <td>EndPoint ID</td>
                        <td>{{.EndPoint.ID}}</td>
                    </tr>

                    <tr>
                        <td>Actual URL</td>
                        <td>{{.EndPoint.ActualURL}}</td>
                    </tr>
                    <tr>
                        <td>EndPoint Name</td>
                        <td>{{.EndPoint.Name}}</td>
                    </tr>

                    <tr>
                        <td>EndPoint Method</td>
                        <td>{{.EndPoint.Method}}</td>
                    </tr>

                    <tr>
                        <td>Parsed URL</td>
                        <td><ol>
                            {{range $k,$v := .EndPoint.ParsedUrl}}
                            <li>{{$k}} = {{$v}}</li>
                            {{end}}
                        </ol>
                        </td>
                    </tr>


                    <tr>
                        <td>Path Params</td>
                        <td><ol>
                            {{range $k,$v := .EndPoint.PathParams}}
                            <li>{{$k}} = {{$v.Name}} | {{$v.Value}} | {{$v.DataType}} | {{$v.IsVariable}}</li>
                            {{end}}
                        </ol>
                        </td>
                    </tr>
                    <tr>
                        <td>On Hold?</td>
                        <td>{{yesNo .EndPoint.OnHold}}</td>
                    </tr>
                    <tr>
                        <td>Sample request</td>
                        <td><textarea rows="25" cols="100">{{.EndPoint.SampleRequest}}</textarea></td>
                    </tr>
               
                    {{range .EndPoint.ResponseMap}}
                    <tr>
                        <td>Response &ldquo;{{.Name}}&rdquo; ({{.HttpCode}})</td>
                        <td><textarea rows="25" cols="100">{{.Response}}</textarea></td>
                    </tr>

                    <tr>
                        <td>&nbsp;&nbsp;Placeholder</td>
                        <td><textarea rows="25" cols="100">{{.ResponsePlaceholder}}</textarea></td>
                    </tr>

                    <tr>
                        <td>&nbsp;&nbsp;Header</td>
                        <td><textarea rows="25" cols="100">{{.ResponseHeader}}</textarea></td>
                    </tr>

                    <tr>
                        <td>&nbsp;&nbsp;Header Placeholder</td>
                        <td><textarea rows="25" cols="100">{{.ResponseHeaderPlaceholder}}</textarea></td>
                    </tr>
                    {{end}}

                </tbody>
            </table>

            <a class="btn btn-primary " href="/endpoints">Back to Server list</a>

            <br />
            <br />
            <br />
        </div>
    </div>
</div>

{{end}}